# Cloudflare Tunnel token — get this from:
#   cloudflared tunnel create knowledge-vault
# Or from the Cloudflare Zero Trust dashboard → Networks → Tunnels → Create
CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token-here

# Vault access token — REQUIRED when exposing the vault beyond localhost
# (e.g. on a LAN or via Cloudflare Tunnel). Any non-empty value enables
# bearer-token auth on every /api/* endpoint. Generate one with e.g.
#   openssl rand -hex 32
# If unset, the server logs a startup warning and runs without auth.
VAULT_AUTH_TOKEN=

# Comma-separated list of extra CORS origins. The vault frontend is served
# same-origin so this is rarely needed. Use `*` to allow any origin (the
# bearer token still gates access). Example:
#   VAULT_ALLOWED_ORIGINS=https://some-bookmarklet-host.example
VAULT_ALLOWED_ORIGINS=
