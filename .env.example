# Login password — REQUIRED when exposing the vault to the internet.
# If unset, the vault is open (no login screen). Set a strong password before
# exposing it through any tunnel or reverse proxy.
AUTH_PASSWORD=

# Secret used to sign session cookies. Keep stable so users aren't logged out
# on every container restart. If blank, one is auto-generated and persisted to
# the vault directory (.vault-secret, chmod 600). Use at least 32 random chars.
AUTH_SECRET=

# How long a login session stays valid, in days (default 30)
AUTH_SESSION_DAYS=30
